# Base URL of the API.
#
# In development the Vite proxy forwards /api to http://localhost:8000. In
# production Caddy serves the SPA and the API from the same origin, so the
# relative default is correct in both cases; only change it if you split the
# two onto separate hostnames, which also means configuring CORS.
VITE_API_URL=/api

# Public origin of this frontend. Used for absolute Open Graph URLs: WhatsApp
# and Facebook do not resolve relative image paths, and a blank link preview
# costs real clicks on the channel Nuvo links are shared through.
VITE_SITE_URL=http://localhost:5173

# Google Sign-In client id (Google Cloud Console → Credentials → OAuth client).
VITE_GOOGLE_CLIENT_ID=
