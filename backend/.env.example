# ─────────────────────────────────────────────────────────────────────────────
# Nuvo — backend configuration
#
# Copy to .env and fill in. Values marked REQUIRED have no safe default: the
# feature they control fails closed rather than guessing.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Nuvo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Frontend ────────────────────────────────────────────────────────────
# Absolute URL of the Vue app. Every link in an email, every payment redirect
# and every shareable booking URL is built from this — a wrong value here sends
# real customers to the wrong host.
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed to call this API. Must include the deployed
# frontend, or the browser blocks every request.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nuvo
DB_USERNAME=root
DB_PASSWORD=

# In production a single connection string is usually simpler (Neon, Supabase):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Runtime ─────────────────────────────────────────────────────────────
# `database` needs a running worker (php artisan queue:work). Use `sync` only in
# local development: on sync, sending a WhatsApp message happens inside the
# customer's booking request.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=cookie

# ─── Uploads ─────────────────────────────────────────────────────────────
# `public` writes to storage/app/public — fine locally, silent data loss on any
# host with an ephemeral filesystem (Render, Fly, Heroku). Use s3 in production.
UPLOAD_DISK=public
FILESYSTEM_DISK=local

# S3 / Cloudflare R2 / any S3-compatible bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Mail ────────────────────────────────────────────────────────────────
# `log` writes messages to storage/logs and sends nothing. Password resets and
# booking confirmations need a real transport in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="bonjour@nuvo.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Google sign-in ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Payments (Flutterwave) ──────────────────────────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# REQUIRED in production. The webhook rejects every request while this is empty,
# on purpose: without it there is no way to tell Flutterwave from anyone else.
FLW_WEBHOOK_HASH=

# ─── WhatsApp ────────────────────────────────────────────────────────────
# twilio | meta | none. With `none`, merchants still get email and the dashboard,
# and customers still get the tap-to-send wa.me links.
WHATSAPP_PROVIDER=none

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERSION=v21.0

# ─── SMS (Africa's Talking) ──────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=NUVO
