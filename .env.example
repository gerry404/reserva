# ─────────────────────────────────────────────────────────────────────────────
# Réserva — VPS deployment
#
#   cp .env.example .env && nano .env && docker compose up -d --build
#
# This single file configures every container. Values marked REQUIRED have no
# safe default: the feature behind them fails closed rather than guessing.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Domain ──────────────────────────────────────────────────────────────
# The DNS A/AAAA record for this name must already point at the VPS before the
# first `docker compose up`, or Let's Encrypt cannot issue the certificate.
DOMAIN=reserva.cm
TLS_EMAIL=admin@reserva.cm

# The SPA and the API share this origin, which is why CORS never comes up.
APP_URL=https://reserva.cm
FRONTEND_URL=https://reserva.cm

# ─── Application ─────────────────────────────────────────────────────────
APP_NAME=Réserva
APP_ENV=production
APP_DEBUG=false

# REQUIRED. Generate once and keep it: rotating it invalidates every session
# and makes existing encrypted values unreadable.
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─── Database ────────────────────────────────────────────────────────────
# Runs in the postgres container on a named volume. Not exposed to the host.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reserva
DB_USERNAME=reserva
# REQUIRED. Generate one: openssl rand -base64 32
DB_PASSWORD=

# ─── Runtime ─────────────────────────────────────────────────────────────
# Shared across containers, so both must be backed by the database rather than
# by per-process files: the worker and the web app have to see the same queue.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=cookie

# ─── Uploads ─────────────────────────────────────────────────────────────
# `public` is correct here: the volume is on your own disk and survives
# deploys, unlike a managed host's ephemeral filesystem. Caddy serves it
# directly from /srv/uploads.
UPLOAD_DISK=public
FILESYSTEM_DISK=local

# ─── Mail ────────────────────────────────────────────────────────────────
# REQUIRED for password resets and booking confirmations to reach anyone.
# `log` writes messages to a file nobody reads.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=bonjour@reserva.cm
MAIL_FROM_NAME=Réserva

# ─── Google sign-in ──────────────────────────────────────────────────────
# Authorised JavaScript origin in the Google console must be APP_URL exactly.
# Also baked into the frontend bundle at build time — change it and rebuild.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Payments (Flutterwave) ──────────────────────────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# REQUIRED. The webhook rejects every request while this is empty, by design:
# without it there is no way to tell Flutterwave from anyone else who found
# the URL. Set the same value in the Flutterwave dashboard, and point the
# webhook at https://your-domain/api/webhooks/flutterwave
FLW_WEBHOOK_HASH=

# ─── WhatsApp ────────────────────────────────────────────────────────────
# twilio | meta | none. With `none`, merchants still get email and the
# dashboard, and customers still get the tap-to-send wa.me links.
WHATSAPP_PROVIDER=none

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERSION=v21.0

# ─── SMS (Africa's Talking) ──────────────────────────────────────────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=RESERVA
